<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Dipatok supaya rangkaian uji tidak bergantung pada .env mesin yang
             menjalankannya. DesignSystemTest dan GaleriKomponenSiTest memanggil
             route peraga, dan route itu tidak didaftarkan sama sekali saat
             dimatikan; mesin yang .env-nya menyetel false (mis. sedang disiapkan
             untuk hari-H) membuat enam uji gagal tanpa satu pun perubahan kode. -->
        <env name="DESIGN_SYSTEM_ENABLED" value="true"/>
        <!-- Dipatok menyala dengan alasan yang sama seperti DESIGN_SYSTEM_ENABLED.
             Bawaan kedua saklar ini MATI (lihat config/overlay.php), jadi tanpa
             dua baris ini seluruh uji overlay dan live score gagal di mesin mana
             pun. Uji yang justru menguji keadaan mati membaliknya sendiri lewat
             config([...]) di badan uji, karena middleware membaca config saat
             request, bukan saat boot. Bahwa bawaannya memang mati dijaga
             terpisah oleh tests/Unit/SiaranBawaanMatiTest.php. -->
        <env name="OVERLAY_ENABLED" value="true"/>
        <env name="LIVE_SCORE_ENABLED" value="true"/>
        <!-- Kebalikan dari dua saklar di atas: dipatok MATI supaya seluruh uji
             pendaftaran, keuangan, dan bagan menguji alur penuh dengan kedua
             gerbangnya utuh, apa pun isi .env mesin yang menjalankannya. Uji
             yang menguji keadaan menyala membaliknya sendiri lewat config([...]).
             Bahwa bawaannya memang mati dijaga tests/Unit/PendaftaranBawaanMatiTest.php. -->
        <env name="PENDAFTARAN_LEWATI_VERIFIKASI" value="false"/>
        <env name="PENDAFTARAN_LEWATI_PEMBAYARAN" value="false"/>
        <!-- Test memakai database MySQL terpisah. Buat sekali:
             CREATE DATABASE digiscoring_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci; -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="digiscoring_test"/>
        <!--
            Rangkaian uji menyiapkan data prasyaratnya sendiri sambil menyamar
            jadi node gelanggang untuk menguji kepemilikan. Penjagaan "node
            gelanggang tidak menulis data kejuaraan" diuji terpisah, dengan
            saklar ini dinyalakan di dalam ujinya.
        -->
        <env name="SINKRON_JAGA_PENULIS_GLOBAL" value="false"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
